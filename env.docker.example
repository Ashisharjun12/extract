# Copy to .env on server: cp env.docker.example .env
# Fill real values from aimodule/.env + test-backend/.env
#
# PUBLIC_URL = one link testers open (set to https://your-domain before deploy)
PUBLIC_URL=http://localhost
WEB_PORT=80

JWT_SECRET=
WEBHOOK_SECRET=
SESSION_SECRET=
ADMIN_API_KEY=admin
PORTAL_PASSWORD=
DATABASE_URI=

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

GEMINI_API_KEY=
REDIS_QUEUE_URI=
REDIS_RATE_LIMIT_URI=

GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

RUN_WORKERS=false
RUN_DLQ_WORKER=true
DEFAULT_EXTRACT_MODE=async

# New Relic + SigNoz — logs/traces from API and worker; NR only for portal
OBSERVABILITY_PROVIDER=all
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=docs-intelligence-api
NEW_RELIC_WORKER_APP_NAME=docs-intelligence-worker
NEW_RELIC_PORTAL_APP_NAME=docs-intelligence-portal
NEW_RELIC_LOG_FILEPATH=stdout
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=true

OTEL_ENABLED=true
OTEL_TRACES_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://74.113.235.245:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://74.113.235.245:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://74.113.235.245:4318/v1/logs
OTEL_SERVICE_NAME=docs-intelligence-api
OTEL_WORKER_SERVICE_NAME=docs-intelligence-worker
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf

# token ceilings & extraction (single-pass first; chunk/multipass fallback on truncation only)
WORKSHOP_CHUNK_FALLBACK_ENABLED=true
WORKSHOP_CHUNK_PAGE_SIZE=3
POLICY_MULTIPASS_FALLBACK_ENABLED=true
PRESCREEN_REJECT_CONFIDENCE=0.25
PRESCREEN_BLUR_CONFIDENCE=0.55
PRESCREEN_LARGE_PDF_PAGE1=true
#