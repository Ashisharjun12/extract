# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=dev
JWT_SECRET=change-me

# ─── Gemini API ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Human-readable label for logs/NR (never the full key). Falls back to gemini-key-...last8
GEMINI_API_KEY_LABEL=dev-primary

# Model names (must match Google AI model IDs)
AI_MODEL=gemini-3.1-flash-lite
AI_MODEL_LITE=gemini-3.1-flash-lite
AI_MODEL_PRO=gemini-2.5-flash

# Optional per-doc overrides (leave blank to inherit — RC/DL/prescreen → AI_MODEL_LITE, workshop/policy → AI_MODEL_PRO)
RC_AI_MODEL=
DL_AI_MODEL=
WORKSHOP_AI_MODEL=
POLICY_AI_MODEL=
PRESCREEN_MODEL=

# ─── Gemini pricing (USD per 1M tokens) ─────────────────────────────────────
# Update when Google changes rates: https://ai.google.dev/gemini-api/docs/pricing
# Tier is resolved from which .env model name is used in each API call.

# Default tier (AI_MODEL)
AI_MODEL_INPUT_USD_PER_1M=0.25
AI_MODEL_OUTPUT_USD_PER_1M=1.50

# Lite tier — RC, DL, prescreen (AI_MODEL_LITE, RC_AI_MODEL, DL_AI_MODEL)
AI_MODEL_LITE_INPUT_USD_PER_1M=0.25
AI_MODEL_LITE_OUTPUT_USD_PER_1M=1.50

# Pro tier — Workshop, Policy (AI_MODEL_PRO, WORKSHOP_AI_MODEL, POLICY_AI_MODEL)
AI_MODEL_PRO_INPUT_USD_PER_1M=0.30
AI_MODEL_PRO_OUTPUT_USD_PER_1M=2.50

# Cached input (context cache hits) — ~10× cheaper than regular input
AI_MODEL_CACHE_INPUT_USD_PER_1M=0.025
AI_MODEL_LITE_CACHE_INPUT_USD_PER_1M=0.025
AI_MODEL_PRO_CACHE_INPUT_USD_PER_1M=0.03

# USD → INR for costINR in logs and New Relic
USD_TO_INR=84

# ─── Prompt / Context caching ────────────────────────────────────────────────
# off | implicit (recommended) | explicit
PROMPT_CACHING=implicit
PROMPT_CACHE_TTL_SECONDS=3600
PROMPT_CACHE_MIN_TOKENS=2048

# ─── Token ceilings (see src/cost/token-budget.ts) ───
#
# *_MAX_OUTPUT_TOKENS = ceiling per Gemini call (NOT total job tokens).
#
# WHEN TO INCREASE WORKSHOP_MAX_OUTPUT_TOKENS / POLICY_MAX_OUTPUT_TOKENS:
#   • Only if chunk/multipass fallback still truncates (rare).
#   • 65536 is Gemini's practical cap — raising higher rarely helps.
#
# CHUNK / MULTIPASS FALLBACK (cost-optimal — Approach A local PDF split):
#   • Always tries single-pass first (1 API call).
#   • On truncation only: workshop slices PDF locally (WORKSHOP_CHUNK_*), policy runs 3-pass with slices.
#   • Set *_FALLBACK_ENABLED=false to DLQ immediately on truncation instead.
#
RC_MAX_OUTPUT_TOKENS=2048
DL_MAX_OUTPUT_TOKENS=2048
WORKSHOP_MAX_OUTPUT_TOKENS=65536
WORKSHOP_CHUNK_FALLBACK_ENABLED=true
WORKSHOP_CHUNK_PAGE_SIZE=3
WORKSHOP_MAX_GEMINI_RETRIES=1
POLICY_MAX_OUTPUT_TOKENS=65536
POLICY_MULTIPASS_FALLBACK_ENABLED=true
POLICY_MAX_GEMINI_RETRIES=1
# RC/DL are already single-pass on Flash-Lite — 1 retry avoids triple cost on blips
RC_MAX_GEMINI_RETRIES=1
DL_MAX_GEMINI_RETRIES=1
PRESCREEN_ENABLED=true
PRESCREEN_MAX_PDF_PAGES=3
PRESCREEN_MAX_OUTPUT_TOKENS=512
PRESCREEN_REJECT_CONFIDENCE=0.25
PRESCREEN_BLUR_CONFIDENCE=0.55
PRESCREEN_LARGE_PDF_PAGE1=true

# ─── Redis / Queue ───────────────────────────────────────────────────────────
REDIS_QUEUE_URI=rediss://default:password@host:6379
REDIS_RATE_LIMIT_URI=rediss://default:password@host:6379
QUEUE_PREFIX=bull
MAX_QUEUE_SIZE=50
JOB_TIMEOUT_MS=120000
# Gemini opossum circuit timeout per AI call (defaults to JOB_TIMEOUT_MS)
GEMINI_CIRCUIT_TIMEOUT_MS=180000
# BullMQ worker lock (defaults to GEMINI_CIRCUIT_TIMEOUT_MS + 30000)
WORKER_LOCK_DURATION_MS=210000
DOWNLOAD_TIMEOUT_MS=45000
PDF_DOWNLOAD_TIMEOUT_MS=120000

# BullMQ job priority (lower number = processed first within same queue)
QUEUE_PRIORITY_URGENT=1
QUEUE_PRIORITY_FAST=1
QUEUE_PRIORITY_HEAVY=5
QUEUE_PRIORITY_LOW=10

# Extract API: sync (wait for result) | async (202 + webhook)
DEFAULT_EXTRACT_MODE=sync

# Redis result cache — skip Gemini if same type+urls within TTL
RESULT_CACHE_ENABLED=true
RESULT_CACHE_TTL_SECONDS=86400

# Deploy split (production: API pods false, worker pods true)
RUN_WORKERS=true
RUN_DLQ_WORKER=true

# ─── GCS ─────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=gcp
GCS_BUCKET_NAME=your-bucket
GCS_PROJECT_ID=your-project
GCS_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Webhook (Laravel) ───────────────────────────────────────────────────────
WEBHOOK_URL=https://your-laravel.com/api/webhook/extraction-complete
WEBHOOK_SECRET=shared-secret-min-32-chars

# ─── Observability ───────────────────────────────────────────────────────────
# both = Pino + New Relic | all = Pino + NR + SigNoz | signoz = Pino + SigNoz only
#
# --- Dev (New Relic only) ---
# OBSERVABILITY_PROVIDER=both
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=docs-intelligence
# NEW_RELIC_LOG_FILEPATH=stdout
# NEW_RELIC_LOG_LEVEL=warn
# OTEL_ENABLED=false
# OTEL_LOGS_ENABLED=false
#
# --- VPS SigNoz + New Relic parallel (current) ---
OBSERVABILITY_PROVIDER=all
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=docs-intelligence
NEW_RELIC_LOG_FILEPATH=stdout
NEW_RELIC_LOG_LEVEL=warn
NEW_RELIC_ENABLED=true
OTEL_ENABLED=true
OTEL_TRACES_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://74.113.235.245:4318
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://74.113.235.245:4318/v1/logs
OTEL_SERVICE_NAME=docs-intelligence-api
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
#
# --- After SigNoz verified — drop New Relic ---
# NEW_RELIC_ENABLED=false
# OBSERVABILITY_PROVIDER=signoz
# OTEL_ENABLED=true
# OTEL_LOGS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://74.113.235.245:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://74.113.235.245:4318/v1/logs
#
# Full guide: docs/SIGNOZ-SETUP.md

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_API_KEY=change-me
DLQ_ALERT_THRESHOLD=20

# Ops alerts → SigNoz UI (see docs/SIGNOZ-SETUP.md). No backend email alerts.
