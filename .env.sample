# ─── aimodule: Gemini (3 tiers — per-doc types inherit from LITE/PRO in config.ts)
GEMINI_API_KEY=AIzaSyBWK227htAwwt4RjC7mYGToryYgsuaxTV4
GEMINI_API_KEY_LABEL=dev-primary
AI_MODEL=gemini-3.5-flash
AI_MODEL_LITE=gemini-3.1-flash-lite
AI_MODEL_PRO=gemini-3.5-flash

# Optional per-doc model overrides (leave blank → RC/DL/prescreen use AI_MODEL_LITE, workshop/policy use AI_MODEL_PRO)
RC_AI_MODEL=gemini-3.1-flash-lite
DL_AI_MODEL=gemini-3.1-flash-lite
WORKSHOP_AI_MODEL=gemini-2.5-flash
WORKSHOP_CHUNK_AI_MODEL=gemini-3.1-flash-lite
POLICY_AI_MODEL=gemini-2.5-flash
PRESCREEN_MODEL=gemini-3.1-flash-lite

# Pricing per tier (USD per 1M tokens) — update when you change AI_MODEL / LITE / PRO above
# Default tier (AI_MODEL)
AI_MODEL_INPUT_USD_PER_1M=1.50
AI_MODEL_OUTPUT_USD_PER_1M=9.00
# Lite tier (RC, DL, prescreen → AI_MODEL_LITE)
AI_MODEL_LITE_INPUT_USD_PER_1M=0.25
AI_MODEL_LITE_OUTPUT_USD_PER_1M=1.50
# Pro tier (workshop, policy → AI_MODEL_PRO) — 3.1 flash-lite; use 0.30/2.50 for gemini-2.5-flash
AI_MODEL_PRO_INPUT_USD_PER_1M=1.50
AI_MODEL_PRO_OUTPUT_USD_PER_1M=9.00
# Cached input (~10× cheaper)
AI_MODEL_CACHE_INPUT_USD_PER_1M=0.025
AI_MODEL_LITE_CACHE_INPUT_USD_PER_1M=0.025
AI_MODEL_PRO_CACHE_INPUT_USD_PER_1M=0.025
USD_TO_INR=94.38


PROMPT_CACHING=implicit
PROMPT_CACHE_TTL_SECONDS=3600
PROMPT_CACHE_MIN_TOKENS=2048

# ─── Token ceilings & extraction cost controls (aimodule) ─────────────────────
# *_MAX_OUTPUT_TOKENS = max JSON output PER Gemini call (not total job tokens).
# Increase WORKSHOP/POLICY only if logs show RESPONSE_TRUNCATED; 65536 fits ≤15 pages.
# Do not raise RC/DL (2048 is plenty). See aimodule/.env.sample for full guide.
RC_MAX_OUTPUT_TOKENS=2048
DL_MAX_OUTPUT_TOKENS=2048
WORKSHOP_MAX_OUTPUT_TOKENS=65536
POLICY_MAX_OUTPUT_TOKENS=65536
# Single-pass first; local PDF chunk fallback only when truncated (Approach A — cost-optimal)
WORKSHOP_CHUNK_FALLBACK_ENABLED=true
WORKSHOP_CHUNK_PAGE_SIZE=2
WORKSHOP_LEAN_MODE=true
POLICY_MULTIPASS_FALLBACK_ENABLED=true
WORKSHOP_MAX_GEMINI_RETRIES=1
POLICY_MAX_GEMINI_RETRIES=1
RC_MAX_GEMINI_RETRIES=1
DL_MAX_GEMINI_RETRIES=1
PRESCREEN_ENABLED=true
PRESCREEN_MAX_PDF_PAGES=3
PRESCREEN_MAX_OUTPUT_TOKENS=512
PRESCREEN_REJECT_CONFIDENCE=0.25
PRESCREEN_BLUR_CONFIDENCE=0.55
PRESCREEN_LARGE_PDF_PAGE1=true

